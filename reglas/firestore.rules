rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
  
  
		// Usuarios
		match /usuarios/{idUsuario} {
 	  		allow create: if request.auth != null;
      		allow delete: if false;
      		allow update: if request.auth != null;
      		allow read: if request.auth != null ;
		}
  
		// Cuentas
		match /cuentas/{idCuenta} {
			allow create: if request.auth != null;
			allow delete: if false;
			allow update: if request.auth != null;
			allow read: if request.auth != null;
			
			match /{allChildren=**} {
				allow read, write: if request.auth != null
			}
		}
    
		// Parametros
		match /parametros/{idCuenta} {
			allow create: if request.auth != null;
			allow delete: if false;
			allow update: if request.auth != null;
			allow read: if request.auth != null ;
		}
    
    // zTest-Usuarios
		match /zTest-usuarios/{idUsuario} {
 	  		allow create: if request.auth != null;
      		allow delete: if false;
      		allow update: if request.auth != null;
      		allow read: if request.auth != null ;
		}
  
		// zTest-Cuentas
		match /zTest-cuentas/{idCuenta} {
			allow create: if request.auth != null;
			allow delete: if false;
			allow update: if request.auth != null;
			allow read: if request.auth != null;
			
			match /{allChildren=**} {
				allow read, write: if request.auth != null
			}
		}
    
		// zTest-Parametros
		match /zTest-parametros/{idCuenta} {
			allow create: if request.auth != null;
			allow delete: if false;
			allow update: if request.auth != null;
			allow read: if request.auth != null ;
		}

	}
}